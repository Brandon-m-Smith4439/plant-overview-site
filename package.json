{
  "name": "monroe-glass-plant-evolution",
  "version": "0.13.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "node scripts/patch-vinext-windows-static-cache.mjs && vinext build",
    "generate:types": "wrangler types worker-configuration.d.ts --config dist/server/wrangler.json",
    "typecheck": "npm run build && npm run generate:types && tsc --noEmit --incremental false",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern worker-configuration.d.ts",
    "validate:js": "node --check public/depth-scene-renderer.js && node --check public/three-depth-scene-renderer.js && node --check public/spatial-index.js && node --check public/geometry-prep-client.js && node --check public/geometry-prep-worker.js && node --check public/render-performance.js && node --check public/editor-access.js && node --check public/workspace-transfer.js && node --check public/first-person-controller.js && node --check public/animation-timeline.js && node --check public/animation-timeline-workspace.js && node --check public/three-mf-exporter.js && node --check public/plant-app.js && node --check public/machine-designs.js && node --check public/machine-design-studio.js",
    "export:machines": "python cad/export_machine_registry.py",
    "db:generate": "drizzle-kit generate",
    "validate:rendering": "node tests/validate-layout-rendering.mjs",
    "validate:animations": "node tests/validate-animations.mjs",
    "validate:four-step-pauses": "node tests/validate-four-step-pauses.mjs",
    "validate:four-corner-pauses": "node tests/validate-four-corner-pauses.mjs",
    "validate:shadows": "node tests/validate-shadows.mjs",
    "validate:floor": "node tests/validate-floor-features.mjs",
    "validate:wheels": "node tests/validate-wheel-occlusion.mjs",
    "validate:selection": "node tests/validate-multi-selection.mjs",
    "validate:designer-library": "node tests/validate-designer-library-selection-mirror.mjs",
    "validate:motion-groups": "node tests/validate-motion-groups.mjs",
    "validate:designer": "node tests/validate-designer-shapes.mjs",
    "validate:hierarchical-animations": "node tests/validate-hierarchical-animations.mjs",
    "validate:design-scaling": "node tests/validate-design-scaling.mjs",
    "validate:design-scale-preservation": "node tests/validate-design-scale-preservation.mjs",
    "validate:transform-sync": "node tests/validate-transform-sync.mjs",
    "validate:structure-camera": "node tests/validate-structure-camera.mjs",
    "validate:performance": "node tests/validate-performance.mjs && node tests/validate-render-performance-runtime.mjs && node tests/validate-viewport-route-lifecycle.mjs",
    "validate:overlap-performance": "node tests/validate-overlap-performance.mjs",
    "validate:renderer": "node tests/validate-renderer-runtime.mjs",
    "validate:retained-renderer": "node tests/validate-retained-three-performance.mjs",
    "validate:production-performance": "node tests/validate-production-performance.mjs",
    "validate:deep-performance": "node tests/validate-deep-performance-pass.mjs",
    "validate:overview-stability": "node tests/validate-overview-stability.mjs",
    "validate:transition-envelope-visuals": "node tests/validate-transition-envelope-visuals.mjs",
    "validate:plant-scaling": "node tests/validate-plant-scaling.mjs",
    "validate:labels": "node tests/validate-label-system.mjs",
    "validate:first-person": "node tests/validate-first-person.mjs",
    "validate:first-person-collisions": "node tests/validate-first-person-collisions.mjs",
    "validate:first-person-rendering": "node tests/validate-first-person-rendering.mjs",
    "validate:columns": "node tests/validate-structural-columns.mjs",
    "validate:machine-creation": "node tests/validate-machine-creation.mjs",
    "validate:plant-design-add": "node tests/validate-plant-design-add.mjs",
    "validate:layout-tools": "node tests/validate-layout-designer-tools.mjs",
    "validate:compact-envelopes": "node tests/validate-compact-envelopes.mjs",
    "validate:animation-timeline": "node tests/validate-animation-timeline.mjs",
    "validate:editor-tabs": "node tests/validate-tabbed-editors.mjs",
    "validate:timeline-workspace": "node tests/validate-timeline-workspace.mjs",
    "validate:timeline-repair": "node tests/validate-timeline-repair.mjs",
    "validate:public-viewer": "node tests/validate-public-viewer-controls.mjs",
    "validate:cad": "py -B cad/validate_site.py"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.160.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.2",
    "wrangler": "4.126.0"
  },
  "type": "module"
}
